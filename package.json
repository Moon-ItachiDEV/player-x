{
  "name": "plateforme-gaming",
  "version": "0.9.0",
  "description": "Player X : lance tes jeux Steam, Epic et EA et vois tes amis en ligne.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:update": "node --experimental-strip-types --test src/main/services/updateHandoff.test.ts src/main/services/updateNotes.test.ts",
    "test:launch": "node --experimental-strip-types --test src/main/services/tracking.test.ts src/main/services/launchWatchParse.test.ts src/main/services/launches.test.ts && node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/main/services/launchWatch.test.ts src/renderer/src/launch/*.test.ts",
    "test:news": "node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/main/services/newsFormat.test.ts src/main/services/newsFeed.test.ts src/renderer/src/components/news/feedView.test.ts",
    "test:bf6": "node --experimental-strip-types --test src/main/services/bf6Diff.test.ts",
    "test:cs2": "node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/main/services/cs2Match.test.ts src/main/services/cs2Gsi.test.ts",
    "test:achievements": "node --experimental-strip-types --test src/main/services/achievementsFormat.test.ts",
    "test:played": "node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/shared/played.test.ts src/main/services/demo.test.ts",
    "test:friends": "node --experimental-strip-types --test src/main/services/discordMembers.test.ts",
    "test:home": "node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/renderer/src/components/home/*.test.ts",
    "test:search": "node --import ./scripts/test-resolve.mjs --experimental-strip-types --test src/renderer/src/components/search/*.test.ts",
    "test:ui": "node --experimental-strip-types --test src/renderer/src/styles/*.test.ts",
    "test": "npm run test:update && npm run test:launch && npm run test:news && npm run test:bf6 && npm run test:cs2 && npm run test:achievements && npm run test:played && npm run test:friends && npm run test:home && npm run test:search && npm run test:ui",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "release": "electron-vite build && electron-builder --win --x64 --publish always",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "dev.breezy.playerx",
    "productName": "Player X",
    "files": [
      "out/**/*",
      "!out/main/updateSim-*.js",
      "!out/main/launchSim-*.js",
      "!out/main/bf6Sim-*.js",
      "!out/main/newsSim-*.js",
      "!out/main/cs2Sim-*.js",
      "resources/icon.png",
      "resources/tray*.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Player X",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "Player-X-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Moon-ItachiDEV",
        "repo": "player-x",
        "releaseType": "release"
      }
    ],
    "icon": "resources/icon.png"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "electron-updater": "^6.8.9",
    "psn-api": "^2.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "Player X"
}
