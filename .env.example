# Copie ce fichier en .env (ou remplis les mêmes champs dans Paramètres de l'appli).
# Clé Steam Web API : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Appli Discord : https://discord.com/developers/applications
# Ajoute la redirection http://127.0.0.1:47823/discord/callback dans OAuth2 > Redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
